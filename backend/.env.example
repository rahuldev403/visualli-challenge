# ---------------------------------------------------------------------------
# Provider
# ---------------------------------------------------------------------------
# Leave MOCK_MODE=true to run the whole app with canned fixtures and no API key.
# Set it to false and supply a key to call Gemini for real.
MOCK_MODE=true

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any model that supports structured output. Overridable because model names
# move faster than this repo will.
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Generation strategy
# ---------------------------------------------------------------------------
# two-phase (default) = cheap outline pass, then summaries + connections.
# single              = one blocking call. Faster, but weaker id discipline.
GENERATION_MODE=two-phase

# Makes the first model call return deliberately invalid output, so the
# corrective-retry path can be demonstrated without an API key. Mock mode only.
MOCK_FAIL_FIRST=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001

# Where generated mindmaps are persisted. Set MINDMAP_STORE=memory to keep them
# in memory only.
DATA_FILE=./data/mindmaps.json
